# ── YouCam Perfect AI ────────────────────────────────────────────────────────
# Get from: https://yce.makeupar.com/api-console
# Required for: Skin Analysis + Apparel Virtual Try-On
YOUCAM_API_KEY=your_youcam_api_key_here

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
# Required for: AI explanations + product ranking
CLAUDE_API_KEY=your_claude_api_key_here

# ── Pinecone Vector Database ─────────────────────────────────────────────────
# Get from: https://app.pinecone.io
# Required for: RAG product search (falls back to keyword search if not set)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=tonewear-fashion

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# ── App Config ───────────────────────────────────────────────────────────────
# Frontend production URL (for CORS). Set after deploying to Vercel.
FRONTEND_URL=https://your-app.vercel.app

# Backend URL (used by frontend)
BACKEND_URL=http://localhost:8000
